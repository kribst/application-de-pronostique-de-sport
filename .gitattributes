# Auto-detect text files and normalize to LF on checkout
* text=auto eol=lf

# Python
*.py text eol=lf

# JavaScript / TypeScript
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf

# Styles
*.css text eol=lf

# Config
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# Shell
*.sh text eol=lf

# Binary files - no line ending conversion
*.pdf binary
*.docx binary
*.doc binary
*.ico binary
*.svg binary
*.png binary
*.jpg jpeg binary
*.woff2 binary
*.ttf binary
