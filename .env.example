# =====================================================================
# pronostique — variables d'environnement (EXEMPLE)
# =====================================================================
# Copier ce fichier vers `.env` a la racine du depot pour un usage local :
#     Copy-Item .env.example .env        (PowerShell)
#     cp .env.example .env               (bash)
# Le vrai `.env` est ignore par git (.gitignore) : ne jamais mettre de
# secret reel dans ce fichier d'exemple.
# Ce meme `.env` est lu par docker-compose.yml (POSTGRES_*) et par Django
# (settings/base.py, via django-environ). Pour pointer Django vers un autre
# fichier : ENV_FILE=C:\chemin\vers\autre.env
# ---------------------------------------------------------------------

# ----- Django : choix des settings -------------------------------------
# dev  : pronostique.settings.dev   (DEBUG=True, SQLite, defaut de manage.py)
# prod : pronostique.settings.prod  (DEBUG=False, Postgres obligatoire, defaut de wsgi.py/asgi.py)
DJANGO_SETTINGS_MODULE=pronostique.settings.dev

# Cle secrete : OBLIGATOIRE en prod (aucune valeur par defaut dans prod.py).
# Generer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me

# DEBUG n'a d'effet qu'en dev ; prod.py force False.
DJANGO_DEBUG=True

# Hotes autorises (liste separee par des virgules).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance CSRF, ex. le frontend Next.js + l'API locale.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
# Origines CORS autorisees a appeler l'API (frontend Next.js local en dev ;
# domaines de prod en production, ex. https://app.example.com).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

DJANGO_LANGUAGE_CODE=fr-fr
DJANGO_TIME_ZONE=Europe/Paris
DJANGO_LOG_LEVEL=INFO

# ----- Base de donnees -------------------------------------------------
# Dev : SQLite local par defaut (backend/src/db.sqlite3) ; Docker Desktop
# etant eteint, Postgres local n'est pas joignable pour l'instant.
# Pour Postgres local via docker compose (une fois `docker compose up -d`) :
# DATABASE_URL=postgres://pronostique:pronostique@localhost:5432/pronostique
DATABASE_URL=

# Variables lues par docker-compose.yml (service db: postgres:16-alpine).
POSTGRES_DB=pronostique
POSTGRES_USER=pronostique
POSTGRES_PASSWORD=pronostique

# ----- Redis / Celery --------------------------------------------------
# Service redis:7-alpine de docker-compose.yml.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Dev/tests sans worker ni Redis : executer les taches en synchrone.
# CELERY_TASK_ALWAYS_EAGER=True
# Fichier de persistance Beat (defaut : backend/src/celerybeat-schedule).
# CELERY_BEAT_SCHEDULE_FILENAME=
# Lancement (depuis backend/src) :
#   celery -A pronostique worker -l info --pool=solo   # worker (Windows)
#   celery -A pronostique beat -l info                 # ordonnanceur

# ----- Fournisseur de donnees sportives (roadmap phase 5) --------------
SPORTS_API_KEY=
SPORTS_API_BASE_URL=

# ----- Auth JWT (roadmap phase 1) --------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ----- Frontend Next.js -------------------------------------------------
# URL du backend Django vue par le serveur Next (routes /api/auth/* et
# proxy.ts). Les requetes navigateur ne touchent jamais Django directement :
# les JWT restent dans des cookies httpOnly poses par Next.
# Local : http://127.0.0.1:8001 (dossier sur le port 8000, souvent pris par un
# conteneur Docker d'un autre projet : `python src/manage.py runserver 8001`)
# Production : https://api.mondomaine.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# ----- Emails (dev : console via dev.py) -------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@pronostique.local

# ----- Production : securite / admin -----------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_ADMINS=admin@example.com
